# Gemini API key. DeepEval accepts GOOGLE_API_KEY; GEMINI_API_KEY is supported
# by this project for backwards compatibility.
GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEY=your-gemini-api-key-here
# Disable anonymous DeepEval/PostHog telemetry for local runs.
DEEPEVAL_TELEMETRY_OPT_OUT=1
# Optional model overrides (defaults avoid shared free-tier quota collisions)
# GEMINI_AGENT_MODEL=gemini-3.5-flash-lite
# GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite

# Optional OpenAI key (judge currently uses Gemini)
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: stream traces to Confident AI dashboard
CONFIDENT_API_KEY=confident_us_your-key-here
